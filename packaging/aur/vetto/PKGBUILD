# Maintainer: vetto contributors
pkgname=vetto
pkgver=0.4.6
pkgrel=1
pkgdesc='Daemon-less sandbox and audit layer for AI coding agents'
arch=('x86_64' 'aarch64')
url='https://github.com/shleder/vetto'
license=('Apache-2.0')
makedepends=('cargo')
provides=('vetto')
conflicts=('vetto' 'vetto-git')
source=("vetto-$pkgver.tar.gz::https://github.com/shleder/vetto/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('e2bd47c7acd0df3026e0c6f5a2355a1fca67d5c71fefdaf7e2819b2dc42a4ffb')

build() {
  cd "vetto-$pkgver"
  cargo build --locked --release
}

check() {
  cd "vetto-$pkgver"
  cargo test --locked
}

package() {
  cd "vetto-$pkgver"
  install -Dm755 target/release/vetto "${pkgdir}/usr/bin/vetto"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -d "${pkgdir}/usr/share/vetto/profiles"
  cp -a profiles/. "${pkgdir}/usr/share/vetto/profiles/"
}
